FROM node:24-slim AS manifests

WORKDIR /app

COPY packages/workflow-contract/package.json packages/workflow-contract/package-lock.json packages/workflow-contract/
COPY backend/packages/automation-core/package.json backend/packages/automation-core/package-lock.json backend/packages/automation-core/
COPY backend/packages/automation-worker-browserbase/package.json backend/packages/automation-worker-browserbase/package-lock.json backend/packages/automation-worker-browserbase/
COPY backend/packages/automation-service-browserbase/package.json backend/packages/automation-service-browserbase/package-lock.json backend/packages/automation-service-browserbase/

FROM manifests AS build

RUN npm ci --prefix packages/workflow-contract \
 && npm ci --prefix backend/packages/automation-core \
 && npm ci --prefix backend/packages/automation-worker-browserbase \
 && npm ci --prefix backend/packages/automation-service-browserbase

COPY packages/workflow-contract/ packages/workflow-contract/
COPY backend/packages/automation-core/ backend/packages/automation-core/
COPY backend/packages/automation-worker-browserbase/ backend/packages/automation-worker-browserbase/
COPY backend/packages/automation-service-browserbase/ backend/packages/automation-service-browserbase/

RUN npm run build --prefix packages/workflow-contract \
 && npm run build --prefix backend/packages/automation-core \
 && npm run build --prefix backend/packages/automation-worker-browserbase \
 && npm run build --prefix backend/packages/automation-service-browserbase

FROM manifests AS production-dependencies

ENV NODE_ENV=production

RUN npm ci --omit=dev --prefix packages/workflow-contract \
 && npm ci --omit=dev --prefix backend/packages/automation-core \
 && npm ci --omit=dev --prefix backend/packages/automation-worker-browserbase \
 && npm ci --omit=dev --prefix backend/packages/automation-service-browserbase

FROM node:24-slim AS runtime

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=8080
ENV AUTOMATION_HOST=0.0.0.0
ENV AUTOMATION_SCREENSHOTS=false

COPY --from=production-dependencies /app/packages/workflow-contract/package.json packages/workflow-contract/package.json
COPY --from=production-dependencies /app/packages/workflow-contract/node_modules/ packages/workflow-contract/node_modules/
COPY --from=production-dependencies /app/backend/packages/automation-core/package.json backend/packages/automation-core/package.json
COPY --from=production-dependencies /app/backend/packages/automation-core/node_modules/ backend/packages/automation-core/node_modules/
COPY --from=production-dependencies /app/backend/packages/automation-worker-browserbase/package.json backend/packages/automation-worker-browserbase/package.json
COPY --from=production-dependencies /app/backend/packages/automation-worker-browserbase/node_modules/ backend/packages/automation-worker-browserbase/node_modules/
COPY --from=production-dependencies /app/backend/packages/automation-service-browserbase/package.json backend/packages/automation-service-browserbase/package.json
COPY --from=production-dependencies /app/backend/packages/automation-service-browserbase/node_modules/ backend/packages/automation-service-browserbase/node_modules/

COPY --from=build /app/packages/workflow-contract/dist/ packages/workflow-contract/dist/
COPY --from=build /app/backend/packages/automation-core/dist/ backend/packages/automation-core/dist/
COPY --from=build /app/backend/packages/automation-worker-browserbase/dist/ backend/packages/automation-worker-browserbase/dist/
COPY --from=build /app/backend/packages/automation-service-browserbase/dist/ backend/packages/automation-service-browserbase/dist/

EXPOSE 8080

CMD ["node", "backend/packages/automation-service-browserbase/dist/main.js"]
