{
  "name": "browser-memory-recorder",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "set -a; [ ! -f secret.txt ] || . ./secret.txt; set +a; NODE_ENV=development tsx watch server.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:changed": "vitest run --changed",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:browserbase": "BROWSERBASE_E2E=1 playwright test tests/e2e/browserbase.spec.ts"
  },
  "dependencies": {
    "@relay/replay-core": "file:../../packages/replay-core",
    "@relay/workflow-contract": "file:../../packages/workflow-contract",
    "@browserbasehq/sdk": "^2.16.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "lucide-react": "^1.25.0",
    "next": "^16.2.11",
    "playwright-core": "^1.61.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.1",
    "tsx": "^4.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.11",
    "jsdom": "^29.0.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.2",
    "vitest": "^4.1.0"
  }
}
