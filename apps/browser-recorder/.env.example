# Required. Keep this value server-side; never prefix it with NEXT_PUBLIC_.
BROWSERBASE_API_KEY=

# Optional. Browserbase infers the project from the API key when omitted.
BROWSERBASE_PROJECT_ID=

# Optional defaults.
BROWSERBASE_REGION=us-west-2
BROWSERBASE_SESSION_TIMEOUT_SECONDS=1800

# Optional in development; required in production. Set all three to enable Relay workspaces
# and background folder runs through the public Relay API.
# Keep these HTTP Basic credentials server-side; never prefix them with NEXT_PUBLIC_.
RELAY_API_BASE_URL=
RELAY_API_USERNAME=
RELAY_API_PASSWORD=

# Optional. Defaults to .data/workflows relative to the project.
WORKFLOW_DATA_DIR=

# Optional. Defaults to .data/profiles relative to the project.
PROFILE_DATA_DIR=

PORT=3000
