{
  "description": "Prevent Codex from bypassing the repository pre-push ADR review.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/tooling/repository/adr-gate.mjs\" codex-pre-tool",
            "timeout": 30,
            "statusMessage": "Checking ADR push safety"
          }
        ]
      }
    ]
  }
}
